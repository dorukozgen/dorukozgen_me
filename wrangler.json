{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dorukozgen-me",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".cloudflare/output/v0/workers/default/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
